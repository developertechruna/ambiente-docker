# ==============================================================================
# Configuración del Entorno Kubernetes
# ==============================================================================
# La IP no está en duro: se obtiene de forma dinámica según la red del host.
# Puede ser sobreescrita pasando la variable de entorno REMOTE_HOST o TARGET_HOST.
# ==============================================================================

# Función para detectar dinámicamente la IP de la interfaz de red principal
get_dynamic_ip() {
    local ip=""
    # 1. Probar ruta de salida hacia el gateway/red
    ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')
    # 2. Fallback a hostname -I
    if [[ -z "${ip}" ]]; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi
    # 3. Fallback a primera dirección IPv4 global
    if [[ -z "${ip}" ]]; then
        ip=$(ip -4 addr show scope global 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n 1)
    fi
    echo "${ip}"
}

# Obtener IP dinámica del host actual
DETECTED_IP="$(get_dynamic_ip)"

# Host / IP del servidor:
# - Si se definió previamente en el entorno (ej: REMOTE_HOST=x.x.x.x o TARGET_HOST=x.x.x.x), se respeta.
# - Si se ejecuta en el propio servidor destino, toma la IP detectada dinámicamente.
# - Puede definirse un hostname o FQDN si se dispone de DNS.
REMOTE_HOST="${REMOTE_HOST:-${TARGET_HOST:-${DETECTED_IP:-}}}"

# Usuario para conexión remota SSH (por defecto)
REMOTE_USER="${REMOTE_USER:-p3lud3v}"

# Puerto SSH (por defecto 22)
REMOTE_SSH_PORT="${REMOTE_SSH_PORT:-22}"

# Puerto NodePort para Kubernetes Dashboard (30000 - 32767)
DASHBOARD_NODEPORT="${DASHBOARD_NODEPORT:-30443}"

# Versión de Kubernetes Dashboard
DASHBOARD_VERSION="${DASHBOARD_VERSION:-v2.7.0}"

# Argumentos dinámicos para K3s usando la IP obtenida para los certificados TLS
if [[ -n "${REMOTE_HOST}" ]]; then
    K3S_EXTRA_ARGS="--tls-san ${REMOTE_HOST} --write-kubeconfig-mode 644"
else
    K3S_EXTRA_ARGS="--write-kubeconfig-mode 644"
fi
