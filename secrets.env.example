# ==============================================================================
# SECRETS & CREDENTIALS TEMPLATE - AMBIENTE DOCKER
# Copia este archivo a 'secrets.env' y define contraseñas seguras.
# ==============================================================================

# PostgreSQL (namespace: databases)
POSTGRES_DB=app_task
POSTGRES_USER=app_task
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Oracle 19c Enterprise (namespace: databases)
ORACLE_PWD=YourSecureOraclePassword123#
ORACLE_SID=ORCLCDB
ORACLE_PDB=ORCLPDB1
ORACLE_CHARACTERSET=AL32UTF8

# ViniPlay (namespace: viniplay)
VINI_SESSION_SECRET=replace_with_a_secure_session_secret_32_chars

# Tasks App Backend (namespace: tasks-app)
APP_DB_USER=app_task
APP_DB_PASSWORD=your_secure_postgres_password_here
