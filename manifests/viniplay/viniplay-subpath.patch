+        if (req.url === basePath) {
+            return res.redirect(301, `${basePath}/`);
+        } else if (req.url.startsWith(basePath + '/') || req.url.startsWith(basePath + '?')) {
+            req.url = req.url.slice(basePath.length) || '/';
+            if (!req.url.startsWith('/') && !req.url.startsWith('?')) {
